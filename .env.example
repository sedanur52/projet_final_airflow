AIRFLOW_IMAGE=apache/airflow:2.9.1
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

FRANKFURTER_BASE_URL=https://api.frankfurter.app
FRANKFURTER_BASE_CURRENCY=EUR
FRANKFURTER_TARGET_CURRENCIES=USD,GBP,JPY,CHF,CAD

FX_ALERT_THRESHOLD=0.05
FX_FRESHNESS_THRESHOLD_DAYS=2

TASK_RETRIES=2
TASK_RETRY_DELAY_SECONDS=30
TASK_TIMEOUT_SECONDS=120

TARGET_POSTGRES_HOST=postgres
TARGET_POSTGRES_PORT=5432
TARGET_POSTGRES_DB=fx_rates
TARGET_POSTGRES_USER=fx_user
TARGET_POSTGRES_PASSWORD=fx_password

AIRFLOW_POSTGRES_CONN_ID=postgres_fx
AIRFLOW_CONN_POSTGRES_FX=postgresql://fx_user:fx_password@postgres:5432/fx_rates
